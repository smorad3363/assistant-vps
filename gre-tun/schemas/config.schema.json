{
  "$defs": {
    "cidr": {
      "pattern": "^10\\.[0-9]+\\.[0-9]+\\.[0-9]+/30$",
      "type": "string"
    },
    "forward": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "download_mbps": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "generation": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "listen_ip": {
          "$ref": "#/$defs/ip"
        },
        "listen_port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp",
            "both"
          ]
        },
        "target_ip": {
          "$ref": "#/$defs/ip"
        },
        "target_port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "tunnel_id": {
          "$ref": "#/$defs/id"
        },
        "upload_mbps": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "tunnel_id",
        "listen_ip",
        "protocol",
        "listen_port",
        "target_ip",
        "target_port",
        "enabled",
        "upload_mbps",
        "download_mbps",
        "generation",
        "created_at"
      ],
      "type": "object"
    },
    "id": {
      "maximum": 4095,
      "minimum": 1,
      "type": "integer"
    },
    "ip": {
      "format": "ipv4",
      "type": "string"
    },
    "name": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_. -]+$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "tunnel": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "inside_cidr": {
          "$ref": "#/$defs/cidr"
        },
        "key": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "local_ip": {
          "$ref": "#/$defs/ip"
        },
        "mtu": {
          "maximum": 1400,
          "minimum": 1280,
          "type": "integer"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "pair_id": {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "peer_ip": {
          "$ref": "#/$defs/ip"
        },
        "setup_revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "wan_if": {
          "pattern": "^[A-Za-z0-9_.-]{1,15}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "pair_id",
        "local_ip",
        "peer_ip",
        "wan_if",
        "inside_cidr",
        "key",
        "mtu",
        "enabled",
        "setup_revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:gre-tun:config:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "forwards": {
      "items": {
        "$ref": "#/$defs/forward"
      },
      "maxItems": 4095,
      "type": "array"
    },
    "next_forward_id": {
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
    },
    "next_tunnel_id": {
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
    },
    "role": {
      "enum": [
        "iran",
        "foreign"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "tunnels": {
      "items": {
        "$ref": "#/$defs/tunnel"
      },
      "maxItems": 4095,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "config_revision",
    "role",
    "next_tunnel_id",
    "next_forward_id",
    "tunnels",
    "forwards"
  ],
  "title": "GRE Tunnel Manager config v1",
  "type": "object"
}
